# Maintainer: Utku Halis <personal at utkuhalis dot com dot tr>

pkgname=anyps5-desktop-bin
_pkgname=anyps5-desktop
pkgver=0.1.23
pkgrel=1
pkgdesc='PS5-style launcher for AnyPS5: finds PS5 game dumps, unlocks them with the AnyPS5 engine and starts them'
arch=('x86_64')
url='https://github.com/AnyTogether/AnyPS5-Desktop'
license=('GPL-2.0-only')
# The libraries the launcher, its plugins, libwebrtc and the bundled SDL2 link directly, and
# mpv for libmpv (libmpv.so.2), which the clip player and the voice notes open at run time: the
# launcher (GPL-2.0-only) carries no libmpv of its own from 0.1.21 on.
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'fontconfig'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'harfbuzz'
  'hicolor-icon-theme'
  'libdecor'
  'libdrm'
  'libepoxy'
  'libgcc'
  'libpulse'
  'libstdc++'
  'libx11'
  'libxcomposite'
  'libxcursor'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxi'
  'libxinerama'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'libxxf86vm'
  'mesa'
  'mpv'
  'pango'
  'wayland'
  'xdg-utils'
)
makedepends=('patchelf')
optdepends=(
  'ffmpeg: clips, broadcasting and Remote Play'
  'libsecret: keeps the AnyTogether sign-in in the keyring (secret-tool)'
  'noto-fonts: letters of scripts the launcher font lacks'
  'noto-fonts-cjk: Chinese, Japanese and Korean text'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$_pkgname-$pkgver.deb::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_amd64.deb")
noextract=("$_pkgname-$pkgver.deb")
sha256sums=('1652dc4e872d508accb39828326fae73bc0906f8cb6f7c77c9841310d9f7089e')

package() {
  # The release's .deb: /opt/anyps5-desktop, /usr/bin/anyps5-desktop, the desktop entry, the
  # icons and the application/x-anyps5theme MIME type. The launcher sees it lives in
  # /opt/anyps5-desktop and leaves anyps5:// links to this desktop entry.
  bsdtar -xOf "$_pkgname-$pkgver.deb" 'data.tar.*' | bsdtar -xpf - -C "$pkgdir" --no-same-owner

  # Some plugin libraries keep the release build's own folders (/home/runner/...) in their
  # RUNPATH. What they link sits beside them, so $ORIGIN is all they need.
  local lib
  for lib in "$pkgdir"/opt/anyps5-desktop/lib/*.so; do
    case "$(patchelf --print-rpath "$lib")" in
      */home/*) patchelf --set-rpath '$ORIGIN' "$lib" ;;
    esac
  done
}
